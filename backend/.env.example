PORT=5000
NODE_ENV=development
# MongoDB connection URI (use MongoDB Atlas in production; in local dev, an in-memory database will automatically launch if local mongo is unreachable)
MONGODB_URI=mongodb://127.0.0.1:27017/evhub
JWT_SECRET=evhub_jwt_super_secret_key_change_in_production_2026!
JWT_REFRESH_SECRET=evhub_jwt_refresh_secret_key_change_in_production_2026!
CLIENT_URL=http://localhost:5173

# Razorpay Test / Live Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key

# Cloudinary (Optional - Fallback stores uploads locally in /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Optional - Fallback logs to server console in dev)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=

# Maps Configuration
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
MAPTILER_API_KEY=

# Initial Admin Seed Credentials
ADMIN_EMAIL=admin@evhub.com
ADMIN_PASSWORD=Admin@12345

